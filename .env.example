OPENAI_API_KEY=

TRANSCRIBE_MODEL=gpt-transcribe
TIMING_MODEL=whisper-1
MINUTES_MODEL=gpt-5.6-sol
TRANSCRIBE_CONCURRENCY=4
OPENAI_TIMEOUT_SECONDS=600
